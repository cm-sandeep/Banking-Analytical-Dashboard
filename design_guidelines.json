{
  "typography": {
    "font_family": {
      "headings": "Manrope, sans-serif",
      "body": "IBM Plex Sans, sans-serif",
      "code": "JetBrains Mono, monospace"
    },
    "weights": {
      "light": 300,
      "regular": 400,
      "medium": 500,
      "bold": 700,
      "black": 900
    },
    "sizes": {
      "h1": "text-4xl md:text-5xl font-bold tracking-tight",
      "h2": "text-3xl font-bold tracking-tight",
      "h3": "text-2xl font-semibold tracking-tight",
      "body": "text-base leading-relaxed",
      "small": "text-sm text-muted-foreground",
      "tiny": "text-xs uppercase tracking-wider font-medium"
    }
  },
  "colors": {
    "theme": "dark",
    "palette": {
      "background": "#0B0E14",
      "foreground": "#F8FAFC",
      "card": "#151921",
      "card_foreground": "#F8FAFC",
      "primary": "#006FCF",
      "primary_foreground": "#FFFFFF",
      "secondary": "#FDBF5E",
      "secondary_foreground": "#0B0E14",
      "muted": "#1E293B",
      "muted_foreground": "#94A3B8",
      "accent": "#1E293B",
      "accent_foreground": "#F8FAFC",
      "destructive": "#EF4444",
      "destructive_foreground": "#FFFFFF",
      "border": "#2D3748",
      "input": "#2D3748",
      "ring": "#006FCF",
      "success": "#22C55E",
      "warning": "#F59E0B",
      "info": "#3B82F6"
    },
    "charts": {
      "chart_1": "#006FCF",
      "chart_2": "#FDBF5E",
      "chart_3": "#22C55E",
      "chart_4": "#EF4444",
      "chart_5": "#8B5CF6"
    }
  },
  "layout": {
    "grid_system": "Control Room Grid",
    "spacing": {
      "container_padding": "p-6 md:p-8 lg:p-12",
      "section_gap": "gap-6 md:gap-8",
      "component_gap": "gap-4"
    },
    "structure": {
      "sidebar_width": "w-64",
      "header_height": "h-16",
      "max_width": "max-w-7xl mx-auto"
    }
  },
  "components": {
    "cards": {
      "style": "bg-card border border-white/10 shadow-sm rounded-lg",
      "hover": "hover:border-primary/50 transition-colors duration-300"
    },
    "buttons": {
      "primary": "bg-primary text-primary-foreground hover:bg-primary/90 shadow-md rounded-md px-4 py-2 font-medium transition-all active:scale-95",
      "secondary": "bg-secondary text-secondary-foreground hover:bg-secondary/90 shadow-sm rounded-md px-4 py-2 font-medium transition-all active:scale-95",
      "outline": "border border-input bg-transparent hover:bg-accent hover:text-accent-foreground rounded-md px-4 py-2 transition-all active:scale-95",
      "ghost": "hover:bg-accent hover:text-accent-foreground rounded-md px-4 py-2 transition-all"
    },
    "inputs": {
      "style": "bg-muted/50 border-input focus:ring-2 focus:ring-primary/50 rounded-md px-3 py-2 text-sm placeholder:text-muted-foreground"
    }
  },
  "visual_enhancers": {
    "glassmorphism": "bg-black/40 backdrop-blur-xl border border-white/10",
    "gradients": {
      "subtle_glow": "bg-gradient-to-tr from-primary/10 via-transparent to-transparent",
      "text_gradient": "bg-clip-text text-transparent bg-gradient-to-r from-white to-white/60"
    },
    "borders": "border border-white/5",
    "shadows": {
      "glow": "shadow-[0_0_20px_rgba(0,111,207,0.15)]"
    }
  },
  "motion": {
    "page_transition": {
      "initial": { "opacity": 0, "y": 20 },
      "animate": { "opacity": 1, "y": 0 },
      "exit": { "opacity": 0, "y": -20 },
      "transition": { "duration": 0.3, "ease": "easeOut" }
    },
    "hover_scale": {
      "whileHover": { "scale": 1.02 },
      "whileTap": { "scale": 0.98 }
    },
    "stagger": {
      "container": {
        "hidden": { "opacity": 0 },
        "show": {
          "opacity": 1,
          "transition": { "staggerChildren": 0.1 }
        }
      },
      "item": {
        "hidden": { "opacity": 0, "y": 10 },
        "show": { "opacity": 1, "y": 0 }
      }
    }
  },
