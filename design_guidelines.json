  "instructions_to_main_agent": [
    "Implement the 'Control Room' grid layout for the main dashboard.",
    "Use the specified color palette strictly. Do not introduce new colors unless absolutely necessary for data visualization.",
    "Ensure all interactive elements have hover states defined in the 'components' section.",
    "Use 'Manrope' for all headings and 'IBM Plex Sans' for body text. Import these fonts via Google Fonts in index.html or CSS.",
    "Use 'JetBrains Mono' for the SQL and PySpark code blocks.",
    "Implement the 'Glassmorphism' effect for the sidebar and top navigation bar.",
    "Use 'recharts' for all data visualization. Style the charts to match the dark theme (hide grid lines or make them very subtle, use custom tooltips).",
    "Ensure the 'Merchant Analytics' page uses a dense data grid.",
    "The 'Fraud Detection' page should use the 'destructive' color (Red) for alerts and high-risk scores.",
    "Mock data should be realistic banking transactions. Use the 'faker' library or static JSON data.",
    "All buttons and inputs must use the defined rounded corners (0.5rem) and shadow styles.",
    "Add 'data-testid' to all interactive elements."
  ],
  "universal_guidelines": [
    "Do not use generic centered layouts. Use asymmetry and the 'Control Room' grid.",
    "Avoid 'AI slop' aesthetics (generic gradients, default Bootstrap looks).",
    "Use 2-3x more spacing than typical designs for breathing room, even in dense dashboards.",
    "Every interaction needs micro-animations (hover, focus, active).",
    "Use 'sonner' for toast notifications.",
    "Components must use named exports.",
    "Pages must use default exports."
  ]
}